# This repository is intentionally a curated dotfiles repo, not a dump of ~/.config.
*
!.gitignore
!README.md
!install.sh
!home/
!home/**
!bin/
!bin/**
!alacritty/
!alacritty/alacritty.toml
!bat/
!bat/config
!bat/themes/
!bat/themes/*.tmTheme
!btop/
!btop/btop.conf
!btop/themes/
!btop/themes/catppuccin_mocha.theme
!ghostty/
!ghostty/config
!ghostty/shaders/
!ghostty/shaders/*.glsl
!git/
!git/config
!kitty/
!kitty/kitty.conf
!kitty/launch.conf
!mise/
!mise/config.toml
!nvim/
!nvim/**
!tmux/
!tmux/tmux.conf
!zshrc.d/
!zshrc.d/shortcuts.zsh

*.bak*
*.db
*.db-*
*.log
*.swp
__pycache__/
