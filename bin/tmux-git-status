#!/bin/sh

path=${1:-.}

if ! git -C "$path" rev-parse --show-toplevel >/dev/null 2>&1; then
  exit 0
fi

branch=$(git -C "$path" branch --show-current 2>/dev/null)
[ -n "$branch" ] || branch=$(git -C "$path" rev-parse --short HEAD 2>/dev/null)

if [ -n "$(git -C "$path" status --porcelain 2>/dev/null | head -n 1)" ]; then
  printf '󰊢 %s *' "$branch"
else
  printf '󰊢 %s' "$branch"
fi
